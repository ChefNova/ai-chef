+                        break
+                    except Exception as exc:
+                        message = str(exc).upper()
+                        transient_deadline = (
+                            "504" in message
+                            or "DEADLINE_EXCEEDED" in message
+                            or "DEADLINE EXPIRED" in message
+                        )
+                        if attempt == 0 and transient_deadline:
