+            errors.append(f"Groq: {exc}")
+
+    # FALLBACK: Gemini only if Groq failed or was unavailable.
+    if gemini_api_key and genai is not None:
+        try:
+            started = time.perf_counter()
+            client = genai.Client(
+                api_key=gemini_api_key,
