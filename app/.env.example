# Local development only. Do not commit real API keys.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=qwen/qwen3.8-27b
# Recipe generation has its own model; GROQ_MODEL is for receipts.
GROQ_RECIPE_MODEL=openai/gpt-oss-120b
# Optional native OCR executable, for installations outside PATH.
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# Optional. Where saved pantries and preferences are stored. Defaults to data/chefnova.db.
CHEFNOVA_DB_PATH=
