# ──────────────────────────────────────────────
# ChefNova — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit .env or any file containing real keys.
# ──────────────────────────────────────────────

# --- LLM Providers (at least one required) ---

# Groq API key — used for receipt extraction and recipe generation
# Get one at: https://console.groq.com
GROQ_API_KEY=

# Groq model for receipt extraction
GROQ_MODEL=qwen/qwen3.8-27b

# Groq model for recipe generation (separate quota from receipt model)
GROQ_RECIPE_MODEL=openai/gpt-oss-120b

# Google Gemini API key — fallback provider
# Get one at: https://aistudio.google.com
GEMINI_API_KEY=

# Gemini model identifier
GEMINI_MODEL=gemini-3.8-flash

# --- Storage ---

# Optional. Where saved pantries and preferences are stored.
# Defaults to data/chefnova.db if left blank.
CHEFNOVA_DB_PATH=

# --- Tesseract OCR ---

# Optional: full path to tesseract executable (useful on Windows if not in PATH)
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# --- Observability ---

# Set to "true" to enable verbose token/cost logging to console
CHEFNOVA_DEBUG_LOGGING=false

# Log level for the app (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
